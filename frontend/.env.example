# Local: http://localhost:5000/api — Production build: https://motogearspitstop-com.onrender.com/api
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=

# Canonical site origin for SEO (production build)
VITE_SITE_URL=https://motogearspitstop.com

# Google Maps Platform — Places API (checkout address search). Restrict key by HTTP referrer in Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY=

# Optional Google Analytics 4 (do not commit real IDs in .env to public repos)
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel: base code is in index.html (2295888051251529). Keep in sync if you change pixels.
# VITE_META_PIXEL_ID=2295888051251529
# Conversions API access token → backend META_CAPI_ACCESS_TOKEN + META_PIXEL_ID

# Official Facebook page (footer icon)
# VITE_FACEBOOK_URL=https://www.facebook.com/YourPage

# Official YouTube channel (footer icon)
# VITE_YOUTUBE_URL=https://www.youtube.com/@YourChannel

# WhatsApp community invite link (defaults to the Motogears community group)
# VITE_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/FnAHNpKug3MJ6G9dEenbxI

# After migrating Modern Tech images off disabled cloud `dbplgk8d8`, set your active cloud:
# VITE_CLOUDINARY_DELIVERY_CLOUD=dauynokmb
